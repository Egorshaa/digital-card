APP_TYPE="dev"          # dev | stage | prod (в dev включается лог SQL-запросов Prisma)
APP_PORT="3000"
CORS_ORIGINS="*"

# Database (для docker compose)
DATABASE_USER="postgres"
DATABASE_PASSWORD="password"
DATABASE_NAME="digital_card"
DATABASE_PORT_DOCKER="6432"

# Для локального запуска приложения вне Docker
DATABASE_URL="postgresql://postgres:password@localhost:6432/digital_card?schema=public"
